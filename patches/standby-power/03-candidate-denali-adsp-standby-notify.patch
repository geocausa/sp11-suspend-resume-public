diff --git a/drivers/remoteproc/qcom_q6v5_pas.c b/drivers/remoteproc/qcom_q6v5_pas.c
index a005546..a444be3 100644
--- a/drivers/remoteproc/qcom_q6v5_pas.c
+++ b/drivers/remoteproc/qcom_q6v5_pas.c
@@ -14,6 +14,7 @@
 #include <linux/iommu.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
 #include <linux/of_platform.h>
@@ -28,6 +29,7 @@
 #include <linux/soc/qcom/mdt_loader.h>
 #include <linux/soc/qcom/smem.h>
 #include <linux/soc/qcom/smem_state.h>
+#include <linux/suspend.h>
 
 #include "qcom_common.h"
 #include "qcom_pil_info.h"
@@ -71,6 +73,9 @@ struct qcom_pas {
 	struct rproc *rproc;
 
 	struct qcom_q6v5 q6v5;
+	struct qcom_smem_state *sleep_state;
+	unsigned int sleep_bit;
+	bool sleep_notified;
 
 	struct clk *xo;
 	struct clk *aggre2_clk;
@@ -883,6 +888,17 @@ static int qcom_pas_probe(struct platform_device *pdev)
 	}
 	platform_set_drvdata(pdev, pas);
 
+	if (of_property_match_string(pdev->dev.of_node, "qcom,smem-state-names",
+				     "sleepstate") >= 0) {
+		pas->sleep_state = devm_qcom_smem_state_get(pas->dev, "sleepstate",
+							   &pas->sleep_bit);
+		if (IS_ERR(pas->sleep_state))
+			return dev_err_probe(pas->dev, PTR_ERR(pas->sleep_state),
+					     "failed to get ADSP sleepstate\n");
+		if (pas->sleep_bit >= 32)
+			return dev_err_probe(pas->dev, -EINVAL, "invalid ADSP sleepstate bit\n");
+	}
+
 	ret = device_init_wakeup(pas->dev, true);
 	if (ret)
 		goto free_rproc;
@@ -1912,12 +1928,65 @@ static const struct of_device_id qcom_pas_of_match[] = {
 };
 MODULE_DEVICE_TABLE(of, qcom_pas_of_match);
 
+static bool denali_adsp_sleep_notify;
+module_param(denali_adsp_sleep_notify, bool, 0600);
+MODULE_PARM_DESC(denali_adsp_sleep_notify, "Send the Denali ADSP standby notification during deep suspend");
+
+static int __maybe_unused qcom_pas_suspend_late(struct device *dev)
+{
+	struct qcom_pas *pas = dev_get_drvdata(dev);
+	int ret = 0;
+	u32 mask;
+
+	if (!READ_ONCE(denali_adsp_sleep_notify) || !pas->sleep_state ||
+	    pm_suspend_target_state != PM_SUSPEND_MEM)
+		return 0;
+	if (pas->sleep_notified)
+		return -EIO;
+
+	/* Audio releases its clock votes in regular device suspend. */
+	if (!mutex_trylock(&pas->rproc->lock))
+		return -EBUSY;
+
+	if (pas->rproc->state == RPROC_RUNNING) {
+		mask = BIT(pas->sleep_bit);
+		ret = qcom_smem_state_update_bits(pas->sleep_state, mask, mask);
+		if (!ret)
+			pas->sleep_notified = true;
+	}
+	mutex_unlock(&pas->rproc->lock);
+
+	return ret;
+}
+
+static int __maybe_unused qcom_pas_resume_early(struct device *dev)
+{
+	struct qcom_pas *pas = dev_get_drvdata(dev);
+	int ret;
+
+	if (!pas->sleep_notified)
+		return 0;
+
+	/* Restore the host state before clients resume, including on unwind. */
+	ret = qcom_smem_state_update_bits(pas->sleep_state, BIT(pas->sleep_bit), 0);
+	if (!ret)
+		pas->sleep_notified = false;
+
+	return ret;
+}
+
+static const struct dev_pm_ops qcom_pas_pm_ops = {
+	.suspend_late = pm_sleep_ptr(qcom_pas_suspend_late),
+	.resume_early = pm_sleep_ptr(qcom_pas_resume_early),
+};
+
 static struct platform_driver qcom_pas_driver = {
 	.probe = qcom_pas_probe,
 	.remove = qcom_pas_remove,
 	.driver = {
 		.name = "qcom_q6v5_pas",
 		.of_match_table = qcom_pas_of_match,
+		.pm = pm_sleep_ptr(&qcom_pas_pm_ops),
 	},
 };
 
