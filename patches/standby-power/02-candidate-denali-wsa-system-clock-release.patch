+static int wsa_macro_suspend(struct device *dev)
+{
+	struct wsa_macro *wsa = dev_get_drvdata(dev);
+
+	if (!wsa->system_clock_release)
+		return 0;
+
+	pm_runtime_disable(dev);
+	/* SoundWire holds a runtime reference while its interface clock runs. */
+	if (!pm_runtime_status_suspended(dev)) {
+		pm_runtime_enable(dev);
+		return dev_err_probe(dev, -EBUSY, "WSA is active at system suspend\n");
+	}
+
+	wsa_macro_disable_retained_clocks(wsa);
+	return 0;
+}
+
+static int wsa_macro_resume(struct device *dev)
+{
+	struct wsa_macro *wsa = dev_get_drvdata(dev);
+	int ret;
+
+	if (!wsa->system_clock_release)
+		return 0;
+
+	ret = wsa_macro_enable_retained_clocks(wsa);
+	pm_runtime_enable(dev);
+	if (ret)
+		dev_err(dev, "failed to restore retained WSA clocks: %d\n", ret);
+
+	return ret;
+}
+
 static const struct dev_pm_ops wsa_macro_pm_ops = {
+	.suspend = pm_sleep_ptr(wsa_macro_suspend),
+	.resume = pm_sleep_ptr(wsa_macro_resume),
 	RUNTIME_PM_OPS(wsa_macro_runtime_suspend, wsa_macro_runtime_resume, NULL)
 };
 
