From a8fb3821293fdbdff6a2ad289cfc7b2bc8b90d07 Mon Sep 17 00:00:00 2001
From: SP11 Linux Project <272055834+geocausa@users.noreply.github.com>
Date: Sat, 31 Oct 2026 20:56:05 +0000
Subject: [PATCH 41/47] apparmor: remove unused notification placeholders for
 strict compiler checks

---
 security/apparmor/apparmorfs.c |  4 ----
 security/apparmor/audit.c      | 13 -------------
 2 files changed, 17 deletions(-)

diff --git a/security/apparmor/apparmorfs.c b/security/apparmor/apparmorfs.c
index d7dd63009..b16bfc12e 100644
--- a/security/apparmor/apparmorfs.c
+++ b/security/apparmor/apparmorfs.c
@@ -905,7 +905,6 @@ static long notify_set_filter(struct aa_listener *listener,
 			      unsigned long arg)
 {
 	union apparmor_notif_filters *unotif;
-	struct aa_ns *ns = NULL;
 	long ret;
 	u16 size;
 	void __user *buf = (void __user *)arg;
@@ -935,9 +934,6 @@ static long notify_set_filter(struct aa_listener *listener,
 	/* todo validate to known modes */
 	listener->mask = unotif->modeset;
 	AA_DEBUG(DEBUG_UPCALL, "setting filter mask to 0x%x", listener->mask);
-	if (unotif->ns)
-		/* todo */
-		ns = NULL;
 	if (unotif->filter) {
 		struct aa_dfa *dfa;
 		void *pos = (void *) unotif + unotif->filter;
diff --git a/security/apparmor/audit.c b/security/apparmor/audit.c
index 4dbbe0d35..fc96c536a 100644
--- a/security/apparmor/audit.c
+++ b/security/apparmor/audit.c
@@ -347,19 +347,6 @@ static int null_strcmp(const char *lhs, const char *rhs)
 	return 0;
 }
 
-static int cred_euidcmp(const struct cred *lhs, const struct cred *rhs)
-{
-	if (lhs) {
-		if (rhs) {
-			return uid_cmp(lhs->euid, rhs->euid);
-		} else {
-			return 1;
-		}
-	} else if (rhs) {
-		return -1;
-	}
-	return 0;
-}
 
 /* std C cmp.  negative is less than, 0 is equal, positive greater than */
 long aa_audit_data_cmp(struct apparmor_audit_data *lhs,
