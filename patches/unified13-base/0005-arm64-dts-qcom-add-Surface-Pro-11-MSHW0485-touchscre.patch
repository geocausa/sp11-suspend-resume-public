From 422dda419616df739eb873d2c35b71dd17cac638 Mon Sep 17 00:00:00 2001
From: SP11 Linux Project <272055834+geocausa@users.noreply.github.com>
Date: Tue, 27 Oct 2026 21:19:57 +0000
Subject: [PATCH 05/47] arm64: dts: qcom: add Surface Pro 11 MSHW0485
 touchscreen

Wire the validated Phase91 MSHW0485 touchscreen to QUP1 SE2 on Microsoft Denali. Enable GPI DMA1, select protocol-9 QSPI for both channels, add the D2/D3 pin group, and describe the interrupt/power/reset GPIOs.\n\nDocument the board-specific qcom,biosref-qspi controller opt-in and add a proper MSHW0485 touchscreen binding. Both schema examples and the compiled x1e80100-microsoft-denali-oled DTB validate with dtschema 2026.9.
---
 .../input/touchscreen/microsoft,mshw0485.yaml | 78 +++++++++++++++++++
 .../bindings/spi/qcom,spi-geni-qcom.yaml      |  8 ++
 MAINTAINERS                                   |  1 +
 .../boot/dts/qcom/x1-microsoft-denali.dtsi    | 42 ++++++++++
 4 files changed, 129 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/touchscreen/microsoft,mshw0485.yaml

diff --git a/Documentation/devicetree/bindings/input/touchscreen/microsoft,mshw0485.yaml b/Documentation/devicetree/bindings/input/touchscreen/microsoft,mshw0485.yaml
new file mode 100644
index 000000000..14abb3aec
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/microsoft,mshw0485.yaml
@@ -0,0 +1,78 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/microsoft,mshw0485.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Microsoft Surface G6 MSHW0485 touchscreen
+
+maintainers:
+  - SP11 Linux Project <272055834+geocausa@users.noreply.github.com>
+
+description: |
+  The MSHW0485 touchscreen used by the Microsoft Surface Pro 11 is a
+  HID-over-SPI derived controller connected through a Qualcomm GENI protocol-9
+  QSPI serial engine.  The controller uses active-low interrupt signalling and
+  paired power/reset GPIOs.
+
+allOf:
+  - $ref: touchscreen.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: microsoft,mshw0485
+
+  reg:
+    maxItems: 1
+
+  spi-max-frequency:
+    maximum: 40000000
+
+  interrupts:
+    maxItems: 1
+
+  interrupt-gpios:
+    maxItems: 1
+    description: Active-low touchscreen interrupt line.
+
+  power-gpios:
+    maxItems: 1
+    description: Touchscreen power-enable GPIO.
+
+  reset-gpios:
+    maxItems: 1
+    description: Touchscreen reset GPIO.
+
+required:
+  - compatible
+  - reg
+  - spi-max-frequency
+  - interrupts
+  - interrupt-gpios
+  - power-gpios
+  - reset-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@0 {
+            compatible = "microsoft,mshw0485";
+            reg = <0>;
+            spi-max-frequency = <40000000>;
+            interrupt-parent = <&gpio>;
+            interrupts = <51 IRQ_TYPE_LEVEL_LOW>;
+            interrupt-gpios = <&gpio 51 GPIO_ACTIVE_LOW>;
+            power-gpios = <&gpio 64 GPIO_ACTIVE_HIGH>;
+            reset-gpios = <&gpio 48 GPIO_ACTIVE_HIGH>;
+        };
+    };
+...
diff --git a/Documentation/devicetree/bindings/spi/qcom,spi-geni-qcom.yaml b/Documentation/devicetree/bindings/spi/qcom,spi-geni-qcom.yaml
index edf399681..e458d8515 100644
--- a/Documentation/devicetree/bindings/spi/qcom,spi-geni-qcom.yaml
+++ b/Documentation/devicetree/bindings/spi/qcom,spi-geni-qcom.yaml
@@ -61,6 +61,14 @@ properties:
 
   operating-points-v2: true
 
+  qcom,biosref-qspi:
+    type: boolean
+    description:
+      The serial engine is preloaded by platform firmware with Qualcomm GENI
+      protocol 9 and is wired for the Microsoft Surface G6 QSPI transport.
+      The SPI driver must preserve that firmware and use the board-specific
+      QSPI/GPI-DMA programming sequence instead of loading normal SPI firmware.
+
   power-domains:
     maxItems: 1
 
diff --git a/MAINTAINERS b/MAINTAINERS
index f1c469200..deb4ab8dc 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -18124,6 +18124,7 @@ MICROSOFT SURFACE G6 MSHW0485 TOUCHSCREEN
 M:	SP11 Linux Project <272055834+geocausa@users.noreply.github.com>
 L:	linux-input@vger.kernel.org
 S:	Maintained
+F:	Documentation/devicetree/bindings/input/touchscreen/microsoft,mshw0485.yaml
 F:	drivers/input/touchscreen/g6ts_classifier_profile.h
 F:	drivers/input/touchscreen/g6ts_lifecycle_profile.h
 F:	drivers/input/touchscreen/mshw0485_touch.c
diff --git a/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi b/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi
index e3a53b893..9d86e6344 100644
--- a/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi
+++ b/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi
@@ -1023,6 +1023,41 @@ rtmr0_1p15_reg_en: rtmr0-1p15-reg-en-state {
 	};
 };
 
+&gpi_dma1 {
+	status = "okay";
+};
+
+&i2c10 {
+	status = "disabled";
+};
+
+&spi10 {
+	status = "okay";
+	qcom,biosref-qspi;
+	qcom,enable-gsi-dma;
+
+	dmas = <&gpi_dma1 0 2 QCOM_GPI_QSPI>,
+	       <&gpi_dma1 1 2 QCOM_GPI_QSPI>;
+	dma-names = "tx", "rx";
+
+	pinctrl-0 = <&qup_spi10_data_clk>, <&qup_spi10_cs>,
+		    <&g6ts_qspi_data23>;
+	pinctrl-names = "default";
+
+	touchscreen@0 {
+		compatible = "microsoft,mshw0485";
+		reg = <0>;
+		spi-max-frequency = <40000000>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <51 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-gpios = <&tlmm 51 GPIO_ACTIVE_LOW>;
+
+		power-gpios = <&tlmm 64 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&tlmm 48 GPIO_ACTIVE_HIGH>;
+	};
+};
+
 &qupv3_0 {
 	status = "okay";
 };
@@ -1111,6 +1146,13 @@ &tlmm {
 	gpio-reserved-ranges = <44 4>, /* SPI (TPM) */
 			       <238 1>; /* UFS Reset */
 
+	g6ts_qspi_data23: g6ts-qspi-data23-state {
+		pins = "gpio49", "gpio50";
+		function = "qup1_se2";
+		drive-strength = <6>;
+		bias-disable;
+	};
+
 	hall_int_n_default: hall-int-n-state {
 		pins = "gpio2";
 		function = "gpio";
