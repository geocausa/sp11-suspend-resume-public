+static bool q6apm_info_is_sp11_pull(struct q6apm *apm,
+				    struct audioreach_graph_info *info)
+{
+	struct audioreach_module *pull, *pause, *pcm, *mfc;
+	struct audioreach_sub_graph *sg;
+	u32 subgraphs = 0;
+
+	if (!of_machine_is_compatible("microsoft,denali") ||
+	    !audioreach_graph_has_protected_calibration(info) || info->num_sub_graphs != 3)
+		return false;
+	list_for_each_entry(sg, &info->sg_list, node) {
+		switch (sg->sub_graph_id) {
+		case 0xb0000001:
+			subgraphs |= BIT(0);
+			break;
+		case 0xb000007f:
+			subgraphs |= BIT(1);
+			break;
+		case 0xb000007e:
+			subgraphs |= BIT(2);
+			break;
+		default:
+			return false;
+		}
+	}
+	pull = __q6apm_find_module_by_iid(info, 0x4660);
+	pause = __q6apm_find_module_by_iid(info, SP11_SOFT_PAUSE_IID);
+	pcm = __q6apm_find_module_by_iid(info, 0x465f);
+	mfc = __q6apm_find_module_by_iid(info, 0x466a);
+	return subgraphs == GENMASK(2, 0) && pull &&
+		pull->module_id == MODULE_ID_SH_MEM_PULL_MODE && pause &&
+		pause->module_id == SP11_MODULE_ID_SOFT_PAUSE && pcm &&
+		pcm->module_id == MODULE_ID_PCM_CNV && mfc && mfc->module_id == MODULE_ID_MFC;
+}
