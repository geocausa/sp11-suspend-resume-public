diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 86486be52..becd38adb 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -31,6 +31,7 @@ struct apm_graph_mgmt_cmd {
 #define APM_GRAPH_MGMT_PSIZE(p, n) ALIGN(struct_size(p, sub_graph_id_list, n), 8)
 #define Q6APM_OOB_BUFFER_SIZE	SZ_16K
 #define Q6APM_DSP_SID_MASK	GENMASK(3, 0)
+#define Q6APM_DSP_EUNSUPPORTED	3
 
 /* Windows DEFAULT speaker soft-pause lifecycle, evidence-locked on SP11. */
 #define SP11_MODULE_ID_SOFT_PAUSE		0x07001019
@@ -38,6 +39,10 @@ struct apm_graph_mgmt_cmd {
 #define SP11_PARAM_SOFT_PAUSE_PAUSE		0x0800102e
 #define SP11_PARAM_SOFT_PAUSE_RESUME		0x0800102f
 
+static bool q6apm_info_is_sp11_pull(struct q6apm *apm,
+				    struct audioreach_graph_info *info);
+static void q6apm_put_audioreach_graph(struct kref *ref);
+
 static struct q6apm *g_apm;
 static bool sp11_vi_ready;
 static bool sp11_cps_ready;
@@ -94,6 +99,168 @@ static phys_addr_t q6apm_dsp_addr(struct device *dev, dma_addr_t dma_addr)
 	return dsp_addr;
 }
 
+/* A distinct map type keeps this graph-owned page out of the PCM map slots. */
+#define Q6APM_POSITION_MAP_TOKEN APM_MMAP_TOKEN_MAP_TYPE_MASK
+
+static int q6apm_dsp_status(u32 status)
+{
+	if (!status)
+		return 0;
+	return status == Q6APM_DSP_EUNSUPPORTED ? -EOPNOTSUPP : -EINVAL;
+}
+
+static int q6apm_position_cmd(struct audioreach_graph *graph, struct gpr_pkt *pkt)
+{
+	struct q6apm *apm = graph->apm;
+	unsigned long flags, waited;
+	int ret;
+
+	mutex_lock(&apm->lock);
+	pkt->hdr.token = ((u32)atomic_inc_return(&apm->command_token) << 18) |
+		Q6APM_POSITION_MAP_TOKEN | graph->id;
+	reinit_completion(&graph->position_done);
+	spin_lock_irqsave(&graph->position_lock, flags);
+	graph->position_token = pkt->hdr.token;
+	graph->position_opcode = pkt->hdr.opcode;
+	graph->position_status = 0;
+	graph->position_pending = true;
+	graph->position_uncertain = true;
+	spin_unlock_irqrestore(&graph->position_lock, flags);
+
+	ret = gpr_send_pkt(apm->gdev, pkt);
+	if (ret >= 0) {
+		waited = wait_for_completion_timeout(&graph->position_done, 5 * HZ);
+		spin_lock_irqsave(&graph->position_lock, flags);
+		ret = !waited && graph->position_pending ? -ETIMEDOUT :
+			q6apm_dsp_status(graph->position_status);
+		graph->position_pending = false;
+		spin_unlock_irqrestore(&graph->position_lock, flags);
+	} else {
+		spin_lock_irqsave(&graph->position_lock, flags);
+		graph->position_pending = false;
+		graph->position_uncertain = false;
+		spin_unlock_irqrestore(&graph->position_lock, flags);
+	}
+	mutex_unlock(&apm->lock);
+	return ret;
+}
+
+static int q6apm_position_callback(struct q6apm *apm,
+				   const struct gpr_resp_pkt *data)
+{
+	const struct gpr_hdr *hdr = &data->hdr;
+	struct audioreach_graph *graph;
+	unsigned long flags;
+	u32 opcode, status = 0, handle = 0;
+	bool pending;
+
+	if (hdr->src_port != APM_MODULE_INSTANCE_ID)
+		return 0;
+	if (hdr->opcode == APM_CMD_RSP_SHARED_MEM_MAP_REGIONS) {
+		if (data->payload_size < (int)sizeof(struct apm_cmd_rsp_shared_mem_map_regions))
+			return 0;
+		opcode = APM_CMD_SHARED_MEM_MAP_REGIONS;
+		handle = get_unaligned_le32(data->payload);
+		if (!handle)
+			return 0;
+	} else if (hdr->opcode == GPR_BASIC_RSP_RESULT) {
+		if (data->payload_size < (int)sizeof(struct gpr_ibasic_rsp_result_t))
+			return 0;
+		opcode = get_unaligned_le32(data->payload);
+		status = get_unaligned_le32((u8 *)data->payload + sizeof(u32));
+		/* A successful MAP acknowledgment is not its returned handle. */
+		if (opcode == APM_CMD_SHARED_MEM_MAP_REGIONS && !status)
+			return 0;
+	} else {
+		return 0;
+	}
+
+	graph = idr_find(&apm->graph_idr, hdr->token & APM_MMAP_TOKEN_GID_MASK);
+	if (!graph || !graph->sp11_pull)
+		return 0;
+	spin_lock_irqsave(&graph->position_lock, flags);
+	if (graph->position_token != hdr->token || graph->position_opcode != opcode) {
+		spin_unlock_irqrestore(&graph->position_lock, flags);
+		return 0;
+	}
+	if (!status) {
+		if (opcode == APM_CMD_SHARED_MEM_MAP_REGIONS)
+			graph->position_mem_map_handle = handle;
+		else if (opcode == APM_CMD_SHARED_MEM_UNMAP_REGIONS)
+			graph->position_mem_map_handle = 0;
+	}
+	graph->position_status = status;
+	graph->position_uncertain = false;
+	pending = graph->position_pending;
+	graph->position_pending = false;
+	if (pending)
+		complete(&graph->position_done);
+	spin_unlock_irqrestore(&graph->position_lock, flags);
+	return 0;
+}
+
+static int q6apm_map_position_buffer(struct audioreach_graph *graph)
+{
+	struct apm_shared_map_region_payload *region;
+	struct apm_cmd_shared_mem_map_regions *cmd;
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_apm_cmd_pkt(sizeof(*cmd) + sizeof(*region),
+					     APM_CMD_SHARED_MEM_MAP_REGIONS, 0);
+
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+	graph->position_virt = dma_alloc_coherent(graph->dma_dev, PAGE_SIZE,
+						  &graph->position_dma, GFP_KERNEL);
+	if (!graph->position_virt)
+		return -ENOMEM;
+	memset(graph->position_virt, 0, PAGE_SIZE);
+	graph->position_dsp_addr = q6apm_dsp_addr(graph->dma_dev, graph->position_dma);
+	cmd = (void *)pkt + GPR_HDR_SIZE;
+	cmd->mem_pool_id = APM_MEMORY_MAP_SHMEM8_4K_POOL;
+	cmd->num_regions = 1;
+	cmd->property_flag = APM_MEMORY_MAP_FLAG_UNCACHED;
+	region = (void *)(cmd + 1);
+	region->shm_addr_lsw = lower_32_bits(graph->position_dsp_addr);
+	region->shm_addr_msw = upper_32_bits(graph->position_dsp_addr);
+	region->mem_size_bytes = PAGE_SIZE;
+	return q6apm_position_cmd(graph, pkt);
+}
+
+static int q6apm_unmap_position_buffer(struct audioreach_graph *graph)
+{
+	struct apm_cmd_shared_mem_unmap_regions *cmd;
+	unsigned long flags;
+	u32 handle;
+	bool uncertain;
+	int ret;
+
+	spin_lock_irqsave(&graph->position_lock, flags);
+	uncertain = graph->position_uncertain;
+	handle = graph->position_mem_map_handle;
+	spin_unlock_irqrestore(&graph->position_lock, flags);
+	if (uncertain)
+		return -ETIMEDOUT;
+	if (handle) {
+		struct gpr_pkt *pkt __free(kfree) =
+			audioreach_alloc_apm_cmd_pkt(sizeof(*cmd),
+						     APM_CMD_SHARED_MEM_UNMAP_REGIONS, 0);
+
+		if (IS_ERR(pkt))
+			return PTR_ERR(pkt);
+		cmd = (void *)pkt + GPR_HDR_SIZE;
+		cmd->mem_map_handle = handle;
+		ret = q6apm_position_cmd(graph, pkt);
+		if (ret)
+			return ret;
+	}
+	if (graph->position_virt) {
+		dma_free_coherent(graph->dma_dev, PAGE_SIZE,
+				  graph->position_virt, graph->position_dma);
+		graph->position_virt = NULL;
+	}
+	return 0;
