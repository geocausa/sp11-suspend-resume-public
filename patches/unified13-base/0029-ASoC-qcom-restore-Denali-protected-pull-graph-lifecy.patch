+static int audioreach_graph_client_mgmt_cmd(struct q6apm_graph *graph, u32 opcode)
+{
+	static const u32 sp11_sub_graph_order[] = {
+		0xb0000001, 0xb000007f, 0xb000007e,
+	};
+	struct apm_graph_mgmt_cmd *cmd;
+	struct apm_module_param_data *param;
+	unsigned long flags, waited;
+	int size = APM_GRAPH_MGMT_PSIZE(cmd, ARRAY_SIZE(sp11_sub_graph_order));
+	int ret;
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_cmd_pkt(size, opcode, 0, graph->port->id,
+					 APM_MODULE_INSTANCE_ID);
+
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+	cmd = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	cmd->num_sub_graphs = ARRAY_SIZE(sp11_sub_graph_order);
+	memcpy(cmd->sub_graph_id_list, sp11_sub_graph_order, sizeof(sp11_sub_graph_order));
+	param = &cmd->param_data;
+	param->module_instance_id = APM_MODULE_INSTANCE_ID;
+	param->param_id = APM_PARAM_ID_SUB_GRAPH_LIST;
+	param->param_size = size - APM_MODULE_PARAM_DATA_SIZE;
+
+	/* Serialize with format/event commands, but match run-state replies separately. */
+	mutex_lock(&graph->lock);
+	do {
+		pkt->hdr.token = atomic_inc_return(&graph->apm->command_token);
+	} while (!pkt->hdr.token);
+	reinit_completion(&graph->mgmt_done);
+	spin_lock_irqsave(&graph->mgmt_lock, flags);
+	graph->mgmt_token = pkt->hdr.token;
+	graph->mgmt_opcode = opcode;
+	graph->mgmt_status = 0;
+	graph->mgmt_pending = true;
+	spin_unlock_irqrestore(&graph->mgmt_lock, flags);
+	ret = gpr_send_port_pkt(graph->port, pkt);
+	if (ret >= 0) {
+		waited = wait_for_completion_timeout(&graph->mgmt_done, 5 * HZ);
+		spin_lock_irqsave(&graph->mgmt_lock, flags);
+		ret = !waited && graph->mgmt_pending ? -ETIMEDOUT :
+			q6apm_dsp_status(graph->mgmt_status);
+		graph->mgmt_pending = false;
+		spin_unlock_irqrestore(&graph->mgmt_lock, flags);
+	} else {
+		spin_lock_irqsave(&graph->mgmt_lock, flags);
+		graph->mgmt_pending = false;
+		spin_unlock_irqrestore(&graph->mgmt_lock, flags);
+	}
+	mutex_unlock(&graph->lock);
+	return ret;
+}
+
+static void q6apm_complete_client_mgmt(struct q6apm_graph *graph,
+				       const struct gpr_hdr *hdr,
+				       const struct gpr_ibasic_rsp_result_t *result)
+{
+	unsigned long flags;
+	bool matched;
+
+	spin_lock_irqsave(&graph->mgmt_lock, flags);
+	matched = graph->mgmt_pending && hdr->src_port == APM_MODULE_INSTANCE_ID &&
+		hdr->token == graph->mgmt_token && result->opcode == graph->mgmt_opcode;
+	if (matched) {
+		graph->mgmt_status = result->status;
+		graph->mgmt_pending = false;
+		complete(&graph->mgmt_done);
+	}
+	spin_unlock_irqrestore(&graph->mgmt_lock, flags);
+}
