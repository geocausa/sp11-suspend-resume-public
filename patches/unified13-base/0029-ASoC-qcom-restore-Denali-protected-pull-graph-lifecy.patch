+snd_pcm_uframes_t q6apm_get_pull_hw_pointer(struct q6apm_graph *graph,
+					    struct snd_pcm_runtime *runtime)
+{
+	struct audioreach_graph *ar_graph = graph->ar_graph;
+	struct sh_mem_pull_push_mode_position_buffer *position;
+	u32 before, after, index, size = frames_to_bytes(runtime, runtime->buffer_size);
+	int retries = 4;
+
+	if (!q6apm_graph_is_sp11_pull(graph) || !ar_graph->position_virt)
+		return 0;
+	position = ar_graph->position_virt;
+	do {
+		before = READ_ONCE(position->frame_counter);
+		dma_rmb();
+		index = READ_ONCE(position->index);
+		dma_rmb();
+		after = READ_ONCE(position->frame_counter);
+	} while ((!before || before != after) && --retries);
+	if (!before || before != after || index >= size)
+		index = atomic_read(&ar_graph->position_index);
+	else
+		atomic_set(&ar_graph->position_index, index);
+	return index < size ? bytes_to_frames(runtime, index) : 0;
+}
+EXPORT_SYMBOL_GPL(q6apm_get_pull_hw_pointer);
