From fec8c119100b7afd30a1a481e38b1399fa1d9867 Mon Sep 17 00:00:00 2001
From: SP11 Linux Project <272055834+geocausa@users.noreply.github.com>
Date: Wed, 28 Oct 2026 06:45:16 +0000
Subject: [PATCH 20/47] ASoC: lpass-va-macro: match SP11 Windows DMIC divider

Use the actual 19.2 MHz VA MCLK as the divider basis on Microsoft Denali,
matching the Windows MicArray clock selection while leaving other machines
unchanged.

Source: 0072-ASoC-lpass-va-macro-SP11-match-Windows-DMIC-divider.patch
SHA-256: d7b8c035346e5ba6537be6e9e8aa34ad66ab335d3354cc67579cb9afc529189e

Signed-off-by: SP11 Linux Project <272055834+geocausa@users.noreply.github.com>
---
 sound/soc/codecs/lpass-va-macro.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/sound/soc/codecs/lpass-va-macro.c b/sound/soc/codecs/lpass-va-macro.c
index dbc5795b9..331289605 100644
--- a/sound/soc/codecs/lpass-va-macro.c
+++ b/sound/soc/codecs/lpass-va-macro.c
@@ -7,6 +7,7 @@
 #include <linux/init.h>
 #include <linux/io.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/of_clk.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
@@ -1443,6 +1444,14 @@ static int va_macro_validate_dmic_sample_rate(u32 dmic_sample_rate,
 	u32 div_factor;
 	u32 mclk_rate = VA_MACRO_MCLK_FREQ;
 
+	/*
+	 * Native Windows on Surface Pro 11 (Denali) votes the VA MCLK at
+	 * 19.2 MHz and programs the DMIC clock selector from that rate.
+	 * Linux already requests that same 19.2 MHz MCLK in probe.
+	 */
+	if (of_machine_is_compatible("microsoft,denali"))
+		mclk_rate = 2 * VA_MACRO_MCLK_FREQ;
+
 	if (!dmic_sample_rate || mclk_rate % dmic_sample_rate != 0)
 		goto undefined_rate;
 
