+		WSA884X_DOUT_LSB,
+		WSA884X_TEMP_DOUT_MSB,
+		WSA884X_TEMP_DOUT_LSB,
+		WSA884X_VBAT_DOUT_MSB,
+		WSA884X_VBAT_DOUT_LSB,
+		WSA884X_WAVG_STA,
+		WSA884X_CPS_CTL,
+		WSA884X_CURRENT_LIMIT,
